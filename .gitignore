# ============ Secrets / Env ============
.env
.env.local
.env.*.local
*.pem
*.key

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============ Node / Frontend ============
node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ============ ML / Model artifacts ============
# Never commit model weights, checkpoints, or LoRA adapters
ml/checkpoints/
ml/outputs/
*.pt
*.pth
*.bin
*.safetensors
*.ckpt
adapters/
lora_weights/

# ============ Datasets ============
# Never commit raw or processed datasets
ml/data/raw/
ml/data/processed/
ml/data/*.rar
ml/data/*.zip
*.jpg
*.jpeg
*.png
*.webp
!frontend/public/**
!docs/**/*.png
!docs/**/*.jpg

