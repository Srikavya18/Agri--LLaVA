# Copy this file to .env and fill in real values. Never commit .env itself.

ENVIRONMENT=development

# mock   = DEVELOPMENT ONLY, fake deterministic responses, blocked in production
# remote = call a separately-deployed GPU inference service over HTTP
# local  = load the model in-process (only if this backend runs on a GPU host)
INFERENCE_MODE=mock

# Required if INFERENCE_MODE=remote
MODEL_API_URL=
MODEL_API_KEY=

MODEL_NAME=Qwen2.5-VL-7B-Instruct

# Required if INFERENCE_MODE=local
LORA_ADAPTER_PATH=

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO
